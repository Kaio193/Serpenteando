<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Item 1: era @color/cascavel_surface (BRANCO no tema claro), então os
         chips ficavam brancos sobre o dialog branco = praticamente invisíveis.
         Agora usa o token dos botões: cinza claro no claro, cinza escuro no escuro. -->
    <solid android:color="@color/cascavel_button" />
    <stroke android:width="1dp" android:color="@color/cascavel_outline" />
    <corners android:radius="@dimen/radius_circular" />
</shape>
