<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Renderização 3D via Filament requer OpenGL ES 3.0 -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- Notificações (Android 13+ precisa de permissão explícita) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Feedback tátil no módulo 3D -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Alarme diário funciona mesmo com bateria otimizada.
         SCHEDULE_EXACT_ALARM vale pro Android 12; do 13 em diante o Android
         NEGA esse pedido por padrão e o alarme vira "inexato" (o sistema
         agrupa com outros e ele pode atrasar) — era essa a causa de o
         lembrete das 00:00 chegar um pouco atrasado. O USE_EXACT_ALARM abaixo
         devolve o alarme EXATO sem precisar de tela de permissão. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Reagenda alarmes após reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Wakelock leve para processar alarme -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".SerpenteandoApp"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Serpenteando">

        <activity
            android:name=".view.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Serpenteando">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".view.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Serpenteando">
        </activity>

        <!-- Receiver para notificações agendadas (alarme diário) -->
        <receiver
            android:name=".receiver.NotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.serpenteando.cobra3d.ACTION_DAILY_REMINDER" />
                <action android:name="com.serpenteando.cobra3d.ACTION_MISSIONS_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- Receiver para reagendar alarmes após reboot -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>