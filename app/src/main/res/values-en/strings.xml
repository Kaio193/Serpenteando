    <!-- ========== TOUR 3D - ANATOMIA ========== -->
    <string name="tour_0_name">Scales and Skin</string>
    <string name="tour_0_func">Protection, camouflage and sensory perception</string>
    <string name="tour_0_how">Keratin plates covering the entire body.</string>
    <string name="tour_0_curio">Rattle made of keratin like the scales.</string>
    <string name="tour_1_name">Muscle Layer</string>
    <string name="tour_1_func">Locomotion, constriction and attack</string>
    <string name="tour_1_how">~300 pairs of muscles along the vertebral column.</string>
    <string name="tour_1_curio">Attack speed can reach 2.5 m/s.</string>
    <string name="tour_2_name">Internal and Connective Tissue</string>
    <string name="tour_2_func">Structural support and insulation</string>
    <string name="tour_2_how">Connective tissue surrounds internal organs.</string>
    <string name="tour_2_curio">Can survive up to 2 years without eating.</string>
    <string name="tour_3_name">Complete Skeleton</string>
    <string name="tour_3_func">Axial structure and muscle anchoring</string>
    <string name="tour_3_how">150-300 vertebrae with articulated ribs.</string>
    <string name="tour_3_curio">Rattlesnakes have no limbs.</string>
    <string name="tour_4_name">Skull</string>
    <string name="tour_4_func">Brain protection and prey capture</string>
    <string name="tour_4_how">Mobile bones connected by elastic ligaments.</string>
    <string name="tour_4_curio">Characteristic triangular shape.</string>
    <string name="tour_5_name">Fangs</string>
    <string name="tour_5_func">Venom injection via hypodermic</string>
    <string name="tour_5_how">Modified hollow retractable teeth in the maxilla.</string>
    <string name="tour_5_curio">Measure 1-3 cm, continuously replaced.</string>
    <string name="tour_6_name">Venom Glands</string>
    <string name="tour_6_func">Toxin production and storage</string>
    <string name="tour_6_how">Elongated structures behind the eyes.</string>
    <string name="tour_6_curio">One dose can kill up to 20 adult rats.</string>
    <string name="tour_7_name">Teeth</string>
    <string name="tour_7_func">Prey grip and retention</string>
    <string name="tour_7_how">Rows of recurved teeth on pterygoid bones.</string>
    <string name="tour_7_curio">Can have up to 200 teeth.</string>
    <string name="tour_8_name">Forked Tongue</string>
    <string name="tour_8_func">Chemical particle collection</string>
    <string name="tour_8_how">Long, thin and forked tongue.</string>
    <string name="tour_8_curio">Allows stereoscopic smell detection.</string>
    <string name="tour_9_name">Jacobson Organ</string>
    <string name="tour_9_func">Chemical analysis of pheromones</string>
    <string name="tour_9_how">Sensory chambers in the roof of the mouth.</string>
    <string name="tour_9_curio">Can detect prey up to 200 meters away.</string>
    <string name="tour_10_name">Brain</string>
    <string name="tour_10_func">Sensory processing</string>
    <string name="tour_10_how">Small but specialized.</string>
    <string name="tour_10_curio">Active at just 15°C.</string>
    <string name="tour_11_name">Nervous System</string>
    <string name="tour_11_func">Motor control and reflexes</string>
    <string name="tour_11_how">Brain, spinal cord and peripheral nerves.</string>
    <string name="tour_11_curio">Decapitated can still strike for 60 minutes.</string>
    <string name="tour_12_name">Circulatory System</string>
    <string name="tour_12_func">Oxygen and nutrient transport</string>
    <string name="tour_12_how">Tricardiac heart.</string>
    <string name="tour_12_curio">Can redirect blood flow when swallowing.</string>
    <string name="tour_13_name">Heart</string>
    <string name="tour_13_func">Blood pumping</string>
    <string name="tour_13_how">2 atria, 1 functional ventricle.</string>
    <string name="tour_13_curio">Can shift position when swallowing large prey.</string>
    <string name="tour_14_name">Respiratory System</string>
    <string name="tour_14_func">Gas exchange</string>
    <string name="tour_14_how">Single functional lung.</string>
    <string name="tour_14_curio">Can hold breath for 30 minutes.</string>
    <string name="tour_15_name">Digestive System</string>
    <string name="tour_15_func">Digestion of whole prey</string>
    <string name="tour_15_how">Hydrochloric acid and potent enzymes.</string>
    <string name="tour_15_curio">Stomach pH reaches 1.0.</string>
    <string name="tour_16_name">Liver</string>
    <string name="tour_16_func">Metabolism and storage</string>
    <string name="tour_16_how">Elongated and multilobed.</string>
    <string name="tour_16_curio">Stores up to 30% of body weight.</string>
    <string name="tour_17_name">Kidneys</string>
    <string name="tour_17_func">Excretion and osmoregulation</string>
    <string name="tour_17_how">Elongated and lobulated.</string>
    <string name="tour_17_curio">Loses less than 1% water per day.</string>
    <string name="tour_18_name">Intestines</string>
    <string name="tour_18_func">Nutrient absorption</string>
    <string name="tour_18_how">Short small intestine for a carnivore.</string>
    <string name="tour_18_curio">Can go weeks without defecating.</string>
    <string name="tour_19_name">Reproductive System</string>
    <string name="tour_19_func">Ovoviviparity</string>
    <string name="tour_19_how">Eggs develop inside the female.</string>
    <string name="tour_19_curio">Born with active venom.</string>
    <string name="tour_20_name">Vertebral Column</string>
    <string name="tour_20_func">Flexible axial axis</string>
    <string name="tour_20_how">150-300 procoelous vertebrae.</string>
    <string name="tour_20_curio">Can bend 180 degrees in 0.5s.</string>
    <string name="tour_21_name">Ribs</string>
    <string name="tour_21_func">Visceral protection</string>
    <string name="tour_21_how">Articulated rib pairs per vertebra-expand body diameter 3 times.</string>
    <string name="tour_21_curio">undefined</string>
    <string name="tour_22_name">Tail and Rattle</string>
    <string name="tour_22_func">Acoustic defense signaling</string>
    <string name="tour_22_how">Hollow keratin segments.</string>
    <string name="tour_22_curio">Vibrates 50-60 times per second.</string>

