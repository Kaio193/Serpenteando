<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog: confirmar resposta do quiz — compacto e largo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_glass_bg"
    android:layout_marginHorizontal="28dp"
    android:paddingHorizontal="28dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <!-- Ícone de confirmação — no verde claro de "Inofensiva" (Kaio, 11/10,
         item 8), o mesmo token usado nos filtros e no dialog de idioma. -->
    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_check"
        android:importantForAccessibility="no"
        app:tint="@color/cascavel_inofensiva" />

    <!-- Título -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="19sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/cascavel_on_bg"
        android:text="@string/quiz_confirm_title" />

    <!-- Mensagem -->
    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textSize="15sp"
        android:textColor="@color/cascavel_on_surface_variant"
        android:lineSpacingMultiplier="1.3"
        android:fontFamily="@font/inter" />

    <!-- Botões -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/dialog_btn_secondary"
            android:gravity="center"
            android:text="@string/quiz_confirm_no"
            android:textColor="@color/cascavel_inofensiva"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_semibold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/dialog_btn_primary_inofensiva"
            android:gravity="center"
            android:text="@string/quiz_confirm_yes"
            android:textColor="@color/cascavel_on_button"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_semibold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
