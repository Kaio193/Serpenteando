<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog: missão completa — compacto e largo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_glass_bg"
    android:layout_marginHorizontal="28dp"
    android:paddingHorizontal="28dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <!-- Ícone troféu -->
    <ImageView
        android:id="@+id/dialogTrophyIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_trophy"
        android:importantForAccessibility="no"
        app:tint="@color/cascavel_jade_bright" />

    <!-- Título -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/dialog_mission_complete_title"
        android:textColor="@color/cascavel_jade_bright"
        android:textSize="19sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_semibold"
        android:letterSpacing="0.02" />

    <!-- Pontos -->
    <TextView
        android:id="@+id/dialogPoints"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/dialog_mission_complete_points"
        android:textColor="@color/cascavel_jade_bright"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter" />

    <!-- Divisor -->
    <View
        android:layout_width="48dp"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:layout_gravity="center"
        android:background="@color/cascavel_outline" />

    <!-- Mensagem -->
    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_mission_complete_msg"
        android:textColor="@color/cascavel_on_surface"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:fontFamily="@font/inter" />

    <!-- Botão OK -->
    <TextView
        android:id="@+id/dialogOkButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/dialog_mission_complete_close"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/cascavel_on_button"
        android:background="@drawable/dialog_btn_primary"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
