<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mode_light_screen"
    android:paddingTop="@dimen/space_24">

    <!-- O paddingTop da raiz existe porque esta tela NAO passa pelo
         swipeContainer do MainActivity (que é quem aplica o inset da barra de
         status nas outras telas). Sem ele, o topo do card da serpente subia
         POR CIMA da barra de status (o problema que o Kaio relatou). -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero: imagem grande da serpente -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_margin="@dimen/space_16"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cascavel_outline">

                <ImageView
                    android:id="@+id/heroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/desc_snake_image"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hero_gradient_overlay" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20">

                    <TextView
                        android:id="@+id/categoryBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.12"
                        android:paddingHorizontal="@dimen/space_16"
                        android:paddingVertical="@dimen/space_4"
                        android:textColor="@color/cascavel_jade_bright"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="PEÇONHENTA" />

                    <TextView
                        android:id="@+id/titleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/snake_overlay_text"
                        android:textSize="@dimen/serp_title1"
                        android:textStyle="bold"
                        tools:text="Jararaca" />

                    <!-- Chips de metadados: família + nome científico -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/familyChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:paddingHorizontal="@dimen/space_16"
                            android:paddingVertical="@dimen/space_4"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp"
                            android:background="@drawable/badge_safe"
                            tools:text="Viperidae" />

                        <Space
                            android:layout_width="@dimen/space_8"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/scientificText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:paddingHorizontal="@dimen/space_16"
                            android:paddingVertical="@dimen/space_4"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp"
                            android:textStyle="italic"
                            android:background="@drawable/badge_safe"
                            tools:text="Bothrops jararaca" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Corpo do artigo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingBottom="@dimen/space_64">

                <TextView
                    android:id="@+id/bodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:lineSpacingMultiplier="1.55"
                    android:textColor="@color/cascavel_on_bg"
                    android:textSize="16sp"
                    tools:text="Texto introdutório sobre a serpente..." />

                <!-- Seção: Habitat -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:background="@drawable/bg_section_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/habitatHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_habitat"
                        android:drawablePadding="@dimen/space_8"
                        android:fontFamily="@font/inter"
                        android:text="@string/content_detail_habitat"
                        android:textColor="@color/cascavel_jade_bright"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Habitat" />

                    <TextView
                        android:id="@+id/habitatText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/inter"
                        android:lineSpacingMultiplier="1.5"
                        android:textColor="@color/cascavel_on_surface_variant"
                        android:textSize="15sp"
                        tools:text="Vive em áreas de mata..." />
                </LinearLayout>

                <!-- Seção: Distribuição -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_section_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/distributionHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_distribution"
                        android:drawablePadding="@dimen/space_8"
                        android:fontFamily="@font/inter"
                        android:text="@string/content_detail_distribution"
                        android:textColor="@color/cascavel_jade_bright"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Distribuição" />

                    <TextView
                        android:id="@+id/distributionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/inter"
                        android:lineSpacingMultiplier="1.5"
                        android:textColor="@color/cascavel_on_surface_variant"
                        android:textSize="15sp"
                        tools:text="Presente em todo o Brasil..." />
                </LinearLayout>

                <!-- Seção: Alimentação -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_section_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/dietHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_diet"
                        android:drawablePadding="@dimen/space_8"
                        android:fontFamily="@font/inter"
                        android:text="@string/content_detail_diet"
                        android:textColor="@color/cascavel_jade_bright"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Alimentação" />

                    <TextView
                        android:id="@+id/dietText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/inter"
                        android:lineSpacingMultiplier="1.5"
                        android:textColor="@color/cascavel_on_surface_variant"
                        android:textSize="15sp"
                        tools:text="Alimenta-se de roedores..." />
                </LinearLayout>

                <!-- Seção: Reprodução -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_section_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/reproductionHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_reproduction"
                        android:drawablePadding="@dimen/space_8"
                        android:fontFamily="@font/inter"
                        android:text="@string/content_detail_reproduction"
                        android:textColor="@color/cascavel_jade_bright"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Reprodução" />

                    <TextView
                        android:id="@+id/reproductionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/inter"
                        android:lineSpacingMultiplier="1.5"
                        android:textColor="@color/cascavel_on_surface_variant"
                        android:textSize="15sp"
                        tools:text="Vivípara..." />
                </LinearLayout>

                <!-- Seção: Curiosidades -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_section_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/curiosityHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_curiosity"
                        android:drawablePadding="@dimen/space_8"
                        android:fontFamily="@font/inter"
                        android:text="@string/content_detail_curiosity"
                        android:textColor="@color/cascavel_gold_bright"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Curiosidades" />

                    <TextView
                        android:id="@+id/curiosityText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/inter"
                        android:lineSpacingMultiplier="1.5"
                        android:textColor="@color/cascavel_on_surface_variant"
                        android:textSize="15sp"
                        tools:text="Fato curioso..." />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Botão voltar flutuante -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/backButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_16"
        app:cardBackgroundColor="@color/cascavel_back_button"
        app:cardCornerRadius="@dimen/radius_circular"
        app:cardElevation="0dp"
        app:strokeColor="@color/cascavel_outline"
        app:strokeWidth="1dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/desc_menu"
            android:padding="12dp"
            android:scaleX="-1"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/cascavel_on_bg" />
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>