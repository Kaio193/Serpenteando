<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/min_touch_target"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/space_16"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="@dimen/space_12"
        android:importantForAccessibility="no"
        app:tint="@color/cascavel_on_surface_variant" />

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/SerpenteandoBody" />

    <TextView
        android:id="@+id/rowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_8"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        style="@style/SerpenteandoFootnote"
        android:textColor="@color/cascavel_on_surface_variant" />

    <TextView
        android:id="@+id/rowChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="@color/cascavel_on_surface_variant"
        style="@style/SerpenteandoBody" />
</LinearLayout>
