<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cascavel_radial">

    <!-- SwipeFrameLayout: detecta swipe horizontal pra trocar entre seções -->
    <!-- [ALÉM DO TEI] Wrapper personalizado que detecta arrasto e navega entre abas -->
    <com.kaio.cobra3d.util.SwipeFrameLayout
        android:id="@+id/swipeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="72dp">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/navHostFragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:navGraph="@navigation/nav_graph"
            app:defaultNavHost="true" />

    </com.kaio.cobra3d.util.SwipeFrameLayout>

    <include
        layout="@layout/layout_bottom_nav_custom"
        android:id="@+id/customBottomNav" />

</FrameLayout>
