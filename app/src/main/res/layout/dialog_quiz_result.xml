<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog: resultado do quiz — compacto e largo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_glass_bg"
    android:layout_marginHorizontal="28dp"
    android:paddingHorizontal="28dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <!-- Ícone de resultado (dinâmico: ✓ ou ✗) -->
    <TextView
        android:id="@+id/dialogResultIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textSize="56sp"
        android:textStyle="bold" />

    <!-- Título -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textSize="19sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/cascavel_on_bg" />

    <!-- Score -->
    <TextView
        android:id="@+id/dialogScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/cascavel_jade_bright" />

    <!-- Mensagem detalhada -->
    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textSize="15sp"
        android:textColor="@color/cascavel_on_surface_variant"
        android:lineSpacingMultiplier="1.3"
        android:fontFamily="@font/inter" />

    <!-- Botão fechar -->
    <TextView
        android:id="@+id/dialogCloseButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/dialog_btn_primary"
        android:gravity="center"
        android:text="@string/settings_close"
        android:textColor="@color/cascavel_on_button"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_semibold"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
