<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/mode_light_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingTop="@dimen/space_32">

        <!-- CABEÇALHO PADRÃO (item 11): seta + favicon arredondado + título,
             na mesma altura e no mesmo estilo da tela Início. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/desc_menu"
                android:padding="10dp"
                android:scaleX="-1"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/cascavel_on_bg" />

            <!-- O favicon ao lado do titulo saiu (pedido do Kaio, 30/09): o logo
                 fica SO na Home. -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_10"
                style="@style/SerpenteandoLargeTitle"
                android:text="@string/myths_title"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            style="@style/SerpenteandoBody"
            android:textColor="@color/cascavel_on_surface_variant"
            android:text="@string/myths_subtitle" />
    </LinearLayout>

    <!-- Segmented Control: Filtro -->
    <!-- baselineAligned=false: mantém os 3 chips alinhados pelo TOPO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_12">

        <TextView
            android:id="@+id/filterAll"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/myths_filter_all"
            android:textSize="@dimen/serp_callout"
            android:fontFamily="@font/inter"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/cascavel_on_button"
            android:background="@drawable/chip_jade_selected"
            android:layout_marginEnd="@dimen/space_4" />

        <TextView
            android:id="@+id/filterMyths"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/myths_filter_myths"
            android:textSize="@dimen/serp_callout"
            android:fontFamily="@font/inter"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/cascavel_on_button"
            android:background="@drawable/chip_jade"
            android:layout_marginHorizontal="@dimen/space_4" />

        <TextView
            android:id="@+id/filterTruths"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.3"
            android:gravity="center"
            android:text="@string/myths_filter_truths"
            android:textSize="@dimen/serp_callout"
            android:fontFamily="@font/inter"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/cascavel_on_button"
            android:background="@drawable/chip_jade"
            android:layout_marginStart="@dimen/space_4" />
    </LinearLayout>

    <!-- ViewPager2 — permite arrastar pra trocar de filtro -->
    <!-- [ALÉM DO TEI] Mesmo padrão do Conteúdo Educativo: FragmentStateAdapter
         cria/destrói as abas conforme o swipe. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/mythViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
