<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cascavel_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingTop="@dimen/space_16">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/SerpenteandoLargeTitle"
            android:text="Mitos e Verdades"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            style="@style/SerpenteandoBody"
            android:textColor="@color/cascavel_on_surface_variant"
            android:text="Descubra o que é real sobre as serpentes" />
    </LinearLayout>

    <!-- Segmented Control: Filtro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_12">

        <TextView
            android:id="@+id/filterAll"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Todos"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/cascavel_bg"
            android:background="@drawable/chip_active"
            android:layout_marginEnd="@dimen/space_4" />

        <TextView
            android:id="@+id/filterMyths"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Mitos"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/cascavel_on_surface_variant"
            android:background="@drawable/chip_inactive"
            android:layout_marginHorizontal="@dimen/space_4" />

        <TextView
            android:id="@+id/filterTruths"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Verdades"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/cascavel_on_surface_variant"
            android:background="@drawable/chip_inactive"
            android:layout_marginStart="@dimen/space_4" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mythRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingBottom="@dimen/space_12" />
</LinearLayout>
