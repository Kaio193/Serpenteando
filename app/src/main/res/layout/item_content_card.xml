<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/cascavel_card_dark"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/cascavel_card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_14">

        <!-- Imagem real da serpente -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="92dp"
            android:layout_height="92dp"
            app:cardCornerRadius="@dimen/radius_button"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/cascavel_card_dark">

            <ImageView
                android:id="@+id/contentImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/img_thumb_shade" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_14"
            android:orientation="vertical">

            <!-- O badge segue o texto do card (@color/cascavel_on_card_dark):
                 escuro no modo claro e claro no escuro (Kaio, 07/10). Antes
                 era verde-claro fixo e sumia sobre o card claro. -->
            <TextView
                android:id="@+id/categoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:textColor="@color/cascavel_on_card_dark"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:paddingHorizontal="@dimen/space_8"
                android:paddingVertical="3dp"
                android:background="@drawable/badge_safe"
                tools:text="PEÇONHENTA" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:fontFamily="@font/inter"
                android:textColor="@color/cascavel_on_card_dark"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Jararaca" />

            <TextView
                android:id="@+id/scientificText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/cascavel_on_card_dark_variant"
                android:textSize="12sp"
                android:textStyle="italic"
                tools:text="Bothrops jararaca" />

            <TextView
                android:id="@+id/previewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:fontFamily="@font/inter"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:textColor="@color/cascavel_on_card_dark_variant"
                android:textSize="13sp"
                tools:text="Uma das serpentes peçonhentas mais comuns do Brasil..." />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_8"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/cascavel_on_card_dark_variant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
