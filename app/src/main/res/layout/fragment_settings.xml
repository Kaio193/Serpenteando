<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/mode_light_screen">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingTop="@dimen/space_32"
        android:paddingBottom="@dimen/space_32">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CABEÇALHO PADRÃO: favicon arredondado + título, na mesma
                 altura e no mesmo estilo da tela Início (item 11).
                 O paddingHorizontal do ScrollView já dá os 20dp de margem,
                 então aqui não precisa de margem horizontal extra. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- O favicon ao lado do titulo saiu (pedido do Kaio, 30/09):
                     o logo fica SO na Home. -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/SerpenteandoLargeTitle"
                    android:text="@string/settings_title_bar"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- GERAL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginBottom="@dimen/space_6"
                style="@style/SerpenteandoCaption"
                android:text="@string/section_general"
                android:textColor="@color/cascavel_jade_bright"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/settings_group_bg">

                <include layout="@layout/item_settings_row_click"
                    android:id="@+id/rowLanguage" />
                <include layout="@layout/item_settings_row_click"
                    android:id="@+id/rowNotification" />
                <include layout="@layout/item_settings_row_switch"
                    android:id="@+id/rowDarkMode" />
            </LinearLayout>

            <!-- SOBRE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginBottom="@dimen/space_6"
                style="@style/SerpenteandoCaption"
                android:text="@string/section_about"
                android:textColor="@color/cascavel_jade_bright"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/settings_group_bg">

                <include layout="@layout/item_settings_row_click"
                    android:id="@+id/rowVersion" />
                <include layout="@layout/item_settings_row_click"
                    android:id="@+id/rowCredits" />
                <include layout="@layout/item_settings_row_click"
                    android:id="@+id/rowAbout" />
            </LinearLayout>

            <!-- APOIO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginBottom="@dimen/space_6"
                style="@style/SerpenteandoCaption"
                android:text="@string/section_support"
                android:textColor="@color/cascavel_jade_bright"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/settings_group_bg">

                <include layout="@layout/item_settings_row_click"
                    android:id="@+id/rowContact" />
                <include layout="@layout/item_settings_row_click"
                    android:id="@+id/rowBugReport" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
