<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".view.QuizFragment">

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/desc_menu"
        android:padding="10dp"
        android:scaleX="-1"
        android:src="@drawable/ic_arrow_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/cascavel_on_bg" />

    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/inter"
        android:text="@string/quiz_title"
        android:textColor="@color/cascavel_on_bg"
        android:textSize="@dimen/serp_title3"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintStart_toEndOf="@id/backButton"
        app:layout_constraintTop_toTopOf="@id/backButton"
        tools:text="@string/quiz_title" />

    <TextView
        android:id="@+id/scoreText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/inter"
        android:textColor="@color/cascavel_gold"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/backButton"
        tools:text="0 pts" />

    <LinearLayout
        android:id="@+id/difficultySegment"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="@dimen/space_20"
        android:layout_marginTop="@dimen/space_16"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backButton">

        <TextView
            android:id="@+id/chipFacil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/space_6"
            android:layout_weight="1"
            android:background="@drawable/chip_active"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/quiz_easy"
            android:textColor="@color/cascavel_on_bg"
            android:textSize="@dimen/serp_footnote"
            tools:text="@string/quiz_easy" />

        <TextView
            android:id="@+id/chipMedio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/space_6"
            android:layout_weight="1"
            android:background="@drawable/chip_inactive"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/quiz_medium"
            android:textColor="@color/cascavel_on_surface_variant"
            android:textSize="@dimen/serp_footnote"
            tools:text="@string/quiz_medium" />

        <TextView
            android:id="@+id/chipDificil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/chip_inactive"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/quiz_hard"
            android:textColor="@color/cascavel_on_surface_variant"
            android:textSize="@dimen/serp_footnote"
            tools:text="@string/quiz_hard" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginHorizontal="@dimen/space_20"
        android:layout_marginTop="@dimen/space_20"
        android:max="10"
        android:progress="2"
        android:progressBackgroundTint="@color/cascavel_surface"
        android:progressTint="@color/cascavel_jade_bright"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/difficultySegment" />

    <TextView
        android:id="@+id/questionCounterText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_20"
        android:layout_marginTop="@dimen/space_6"
        android:fontFamily="@font/inter"
        android:textColor="@color/cascavel_on_surface_variant"
        android:textSize="@dimen/serp_caption1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        tools:text="Questão 3 de 10" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_16"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24"
        app:layout_constraintBottom_toTopOf="@id/nextButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/questionCounterText">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_20">

            <LinearLayout
                android:id="@+id/questionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/quiz_card_bg"
                android:orientation="vertical"
                android:padding="@dimen/space_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:importantForAccessibility="no">

                    <TextView
                        android:id="@+id/star1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="2dp"
                        android:text="@string/quiz_star_filled"
                        android:textColor="@color/cascavel_gold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/star2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="2dp"
                        android:text="@string/quiz_star_filled"
                        android:textColor="@color/cascavel_gold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/star3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quiz_star_filled"
                        android:textColor="@color/cascavel_on_surface_variant"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/questionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/cascavel_on_bg"
                    android:textSize="@dimen/serp_quiz_question"
                    android:textStyle="bold"
                    tools:text="@string/quiz_question_example" />
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/optionA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/option_default_bg"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/quiz_option_height"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12">

                <TextView
                    android:id="@+id/optionALetter"
                    android:layout_width="@dimen/quiz_letter_size"
                    android:layout_height="@dimen/quiz_letter_size"
                    android:background="@drawable/quiz_letter_circle_bg"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/cascavel_jade_bright"
                    android:textSize="@dimen/serp_quiz_letter"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/optionAText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:fontFamily="@font/inter"
                    android:text="@string/question_option_a"
                    android:textColor="@color/cascavel_on_bg"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/optionALabel"
                    app:layout_constraintStart_toEndOf="@id/optionALetter"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Jararaca" />

                <TextView
                    android:id="@+id/optionALabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/quiz_label_correct"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/optionB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/option_default_bg"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/quiz_option_height"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12">

                <TextView
                    android:id="@+id/optionBLetter"
                    android:layout_width="@dimen/quiz_letter_size"
                    android:layout_height="@dimen/quiz_letter_size"
                    android:background="@drawable/quiz_letter_circle_bg"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="@color/cascavel_jade_bright"
                    android:textSize="@dimen/serp_quiz_letter"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/optionBText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:fontFamily="@font/inter"
                    android:text="@string/question_option_b"
                    android:textColor="@color/cascavel_on_bg"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/optionBLabel"
                    app:layout_constraintStart_toEndOf="@id/optionBLetter"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Coral Verdadeira" />

                <TextView
                    android:id="@+id/optionBLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/quiz_label_correct"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/optionC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/option_default_bg"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/quiz_option_height"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12">

                <TextView
                    android:id="@+id/optionCLetter"
                    android:layout_width="@dimen/quiz_letter_size"
                    android:layout_height="@dimen/quiz_letter_size"
                    android:background="@drawable/quiz_letter_circle_bg"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="@color/cascavel_jade_bright"
                    android:textSize="@dimen/serp_quiz_letter"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/optionCText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:fontFamily="@font/inter"
                    android:text="@string/question_option_c"
                    android:textColor="@color/cascavel_on_bg"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/optionCLabel"
                    app:layout_constraintStart_toEndOf="@id/optionCLetter"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Cascavel" />

                <TextView
                    android:id="@+id/optionCLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/quiz_label_correct"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/optionD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/option_default_bg"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/quiz_option_height"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_12">

                <TextView
                    android:id="@+id/optionDLetter"
                    android:layout_width="@dimen/quiz_letter_size"
                    android:layout_height="@dimen/quiz_letter_size"
                    android:background="@drawable/quiz_letter_circle_bg"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:text="D"
                    android:textColor="@color/cascavel_jade_bright"
                    android:textSize="@dimen/serp_quiz_letter"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/optionDText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:fontFamily="@font/inter"
                    android:text="@string/question_option_d"
                    android:textColor="@color/cascavel_on_bg"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/optionDLabel"
                    app:layout_constraintStart_toEndOf="@id/optionDLetter"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Sucuri" />

                <TextView
                    android:id="@+id/optionDLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/quiz_label_correct"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/explanationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/quiz_card_bg"
                android:importantForAccessibility="no"
                android:orientation="vertical"
                android:padding="@dimen/space_16"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/resultIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="@font/inter"
                        android:text="@string/quiz_check_icon"
                        android:textColor="@color/cascavel_jade_bright"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/resultLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter"
                        android:text="@string/quiz_correct_example"
                        android:textColor="@color/cascavel_on_bg"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pointsBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/quiz_points_badge_bg"
                        android:fontFamily="@font/inter"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="+200 pts"
                        android:textColor="@color/cascavel_bg"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/explanationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter"
                    android:text="Correto! A Coral Verdadeira (Micrurus) possui o veneno mais potente entre as serpentes brasileiras."
                    android:textColor="@color/cascavel_on_surface_variant"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/nextButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/quiz_button_height"
        android:layout_marginHorizontal="@dimen/space_20"
        android:layout_marginBottom="@dimen/space_20"
        android:background="@drawable/quiz_button_next_bg"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:text="@string/quiz_next"
        android:textColor="@color/cascavel_bg"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/cascavel_jade_bright"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
