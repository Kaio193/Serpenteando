<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 3D — o modelo + a imagem de fundo.
     A interação fica toda no próprio SurfaceView: arrastar gira, pinça dá zoom.
     O modelo vem de assets/Serpente_3D.glb (carregado pelo Anatomy3DRenderer).

     FUNDO (Kaio, 11/10 — item 19): agora quem pinta atrás da cobra é a imagem
     @drawable/fundo_3d (a original da pasta Downloads, copiada sem alteração).
     Funciona porque o SurfaceView roda com setZOrderOnTop(true) e o clear color
     do Filament é transparente (alfa 0) — então a imagem aparece atrás do
     modelo sem precisar mexer em nada do 3D. O ImageView usa centerCrop, que
     preenche a tela sem esticar nem deformar (a proporção da imagem é mantida
     e só sobra um recorte pequeno nas bordas).

     30/09/2026 — entrou a tela de carregamento (loadingModelOverlay): o arquivo
     tem 66 MB, então o usuário vê "CARREGANDO MODELO 3D..." do toque na aba até
     o modelo estar pronto. Ela não é menu nem botão, é só o aviso do carregamento
     — e aparece porque a superfície 3D fica transparente enquanto a cena está
     vazia. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Fundo da área 3D — imagem original do Downloads (fundo 3d).
         Fica ATRÁS do SurfaceView, que é transparente onde não há modelo. -->
    <ImageView
        android:id="@+id/anatomyBackgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/fundo_3d" />

    <com.serpenteando.cobra3d.view.renderer.AnatomySurfaceView
        android:id="@+id/anatomySurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Carregamento. Fica visível desde o toque na aba 3D e é escondida pelo
         Anatomy3DFragment assim que o modelo entra na cena.
         Continua BRANCA de propósito (Kaio, 11/10): o texto "CARREGANDO MODELO
         3D..." é escuro e só fica legível no branco — a imagem de fundo entra
         depois que o modelo carrega. -->
    <LinearLayout
        android:id="@+id/loadingModelOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/loadingModelSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/cascavel_jade" />

        <!-- Cor fixa (onboarding_text): o fundo do 3D é branco nos DOIS temas,
             então usar cascavel_on_bg deixaria o texto invisível no modo escuro. -->
        <TextView
            android:id="@+id/loadingModelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/loading_3d_model"
            android:textColor="@color/onboarding_text"
            android:textSize="@dimen/serp_footnote"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
