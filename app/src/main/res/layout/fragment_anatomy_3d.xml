<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 3D — SÓ o modelo, fundo BRANCO (visualizador 3D do Google).
     Pedido do Kaio (27/09): fundo branco, cobra centralizada, visual limpo,
     sem camadas, sem hotspots, sem tour e SEM NENHUM BOTÃO.
     A interação fica toda no próprio SurfaceView: arrastar gira, pinça dá zoom.
     O modelo vem de assets/Serpente_3D.glb (carregado pelo Anatomy3DRenderer),
     e o branco de verdade é o clear color do Filament — este background aqui
     só garante que a tela já nasça branca antes do primeiro frame.

     30/09/2026 — entrou a tela de carregamento (loadingModelOverlay): o arquivo
     tem 66 MB, então o usuário vê "CARREGANDO MODELO 3D..." do toque na aba até
     o modelo estar pronto. Ela não é menu nem botão, é só o aviso do carregamento
     — e aparece porque a superfície 3D fica transparente enquanto a cena está
     vazia. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Item 19 do Kaio (11/10/2026): fundo da area 3D com a imagem "fundo 3d".
         Fica no fundo e a superficie 3D e transparente (o clear color do
         Anatomy3DRenderer e 0,0,0,0), entao a imagem aparece atras do modelo.
         centerCrop mantem a PROPORCAO: sem esticar nem distorcer. -->
    <ImageView
        android:id="@+id/anatomyBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fundo_3d"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <com.kaio.cobra3d.view.renderer.AnatomySurfaceView
        android:id="@+id/anatomySurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Carregamento. Fica visível desde o toque na aba 3D e é escondida pelo
         Anatomy3DFragment assim que o modelo entra na cena. -->
    <LinearLayout
        android:id="@+id/loadingModelOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/loadingModelSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/cascavel_jade" />

        <!-- Cor fixa (onboarding_text): o fundo do 3D é branco nos DOIS temas,
             então usar cascavel_on_bg deixaria o texto invisível no modo escuro. -->
        <TextView
            android:id="@+id/loadingModelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/loading_3d_model"
            android:textColor="@color/onboarding_text"
            android:textSize="@dimen/serp_footnote"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
