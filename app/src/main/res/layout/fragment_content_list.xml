<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/mode_light_screen">

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginTop="@dimen/space_4"
        android:contentDescription="@string/desc_menu"
        android:padding="10dp"
        android:scaleX="-1"
        android:src="@drawable/ic_arrow_right"
        app:tint="@color/cascavel_on_bg" />

    <!-- Título da tela. Só aparece quando este layout é usado sozinho;
         quando ele vira uma aba do ViewPager (ContentTabFragment), o título
         é escondido porque o fragment pai já mostra o mesmo texto —
         antes aparecia "Conteúdo Educativo" duas vezes na tela. -->
    <TextView
        android:id="@+id/listTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingBottom="@dimen/space_8"
        style="@style/SerpenteandoLargeTitle"
        android:text="@string/content_list_title"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contentRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/space_16"
        android:clipToPadding="false" />

</LinearLayout>
