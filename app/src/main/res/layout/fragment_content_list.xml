<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grouped_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_20"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingBottom="@dimen/space_8"
        style="@style/AppleLargeTitle"
        android:text="Conteúdo Educativo"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_12"
        app:cardCornerRadius="@dimen/radius_search"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/cascavel_surface_container_high"
        app:strokeColor="@color/cascavel_outline"
        app:strokeWidth="0.5dp"
        android:foregroundTint="@color/cascavel_on_surface_variant"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_12">

        <SearchView
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:queryHint="Pesquisar"
            android:iconifiedByDefault="false"
            android:background="@null" />

    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contentRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/space_16"
        android:clipToPadding="false" />

</LinearLayout>
