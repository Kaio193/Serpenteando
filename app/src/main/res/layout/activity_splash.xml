<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_cobra">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Logo do app (favicon) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_favicon"
            android:importantForAccessibility="no"
            android:contentDescription="@string/app_name"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Serpenteando.Favicon" />

        <!-- Nome do app -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            style="@style/SerpenteandoLargeTitle"
            android:text="@string/app_name"
            android:textColor="@color/cascavel_on_bg"
            android:textStyle="bold"
            android:textSize="36sp" />

    </LinearLayout>

</FrameLayout>
