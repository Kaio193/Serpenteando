<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_8"
    style="@style/SerpenteandoCard"
    app:cardBackgroundColor="@color/cascavel_card_dark"
    app:strokeColor="@color/cascavel_card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/statementText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/SerpenteandoHeadline"
                android:textColor="@color/cascavel_on_card_dark" />

            <TextView
                android:id="@+id/badgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/SerpenteandoFootnote"
                android:textStyle="bold"
                android:paddingHorizontal="@dimen/space_8"
                android:paddingVertical="@dimen/space_4"
                android:textColor="@color/cascavel_on_card_dark"
                android:background="@drawable/badge_truth"
                android:gravity="center"
                android:minWidth="48dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/explanationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/SerpenteandoFootnote"
            android:textColor="@color/cascavel_on_card_dark_variant"
            android:lineSpacingExtra="4dp"
            android:paddingTop="@dimen/space_8" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
