<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/mode_light_screen">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_32"
            android:paddingBottom="@dimen/space_32">

            <!-- Header: título + pontuação -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_20"
                android:paddingBottom="@dimen/space_16">

                <!-- O favicon ao lado do titulo saiu (pedido do Kaio, 30/09):
                     o logo fica SO na Home. -->

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/SerpenteandoLargeTitle"
                    android:text="@string/nav_missions"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/missionScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/SerpenteandoTitle3"
                    android:textColor="@color/cascavel_jade"
                    android:text="@string/mission_default_score" />
            </LinearLayout>

            <!-- Card destaque: anel à esquerda + infos à direita (mockup) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SerpenteandoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_20"
                android:layout_marginBottom="@dimen/space_24"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/cascavel_surface_container"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cascavel_gold"
                app:contentPadding="@dimen/space_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Anel de progresso circular com % dentro -->
                    <FrameLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/missionProgressRing"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_gravity="center"
                            app:indicatorColor="@color/cascavel_jade"
                            app:trackColor="@color/cascavel_outline"
                            app:indicatorSize="96dp"
                            app:trackThickness="7dp"
                            app:trackCornerRadius="4dp"
                            android:max="100"
                            android:progress="0" />

                        <TextView
                            android:id="@+id/missionPercentText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="0%"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/cascavel_on_bg" />
                    </FrameLayout>

                    <!-- Textos da missão -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/space_16">

                        <TextView
                            android:id="@+id/missionTitleText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_semibold"
                            android:text="@string/mission_default_title"
                            android:textColor="@color/cascavel_on_bg" />

                        <TextView
                            android:id="@+id/missionDescText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.3"
                            android:fontFamily="@font/inter"
                            android:text="@string/mission_default_desc"
                            android:textColor="@color/cascavel_on_surface_variant" />

                        <!-- Dia X de Y em verde (como no mockup) -->
                        <TextView
                            android:id="@+id/missionProgressText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_10"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/cascavel_jade"
                            android:text="@string/mission_day_counter" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Checklist de itens.
                 Margem 20dp (era 24dp): agora o checklist alinha com o card de
                 destaque, com o título e com o botão — todos na mesma coluna
                 (item 19 do doc, 07/10). -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/missionChecklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_20"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Botão verificar progresso — pill outline dourado -->
            <TextView
                android:id="@+id/verifyProgressButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="@dimen/space_20"
                android:layout_marginTop="@dimen/space_20"
                android:gravity="center"
                android:text="@string/mission_verify_progress"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/cascavel_jade"
                android:background="@drawable/btn_outline_gold"
                android:clickable="true"
                android:focusable="true" />

            <!-- Badge dourado preenchido: "3/4 itens concluídos" -->
            <TextView
                android:id="@+id/missionItemCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/space_14"
                android:paddingHorizontal="@dimen/space_18"
                android:paddingVertical="@dimen/space_8"
                android:background="@drawable/chip_gold_filled"
                android:gravity="center"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/black"
                android:text="@string/mission_items_done" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>