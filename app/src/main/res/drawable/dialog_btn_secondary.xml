<?xml version="1.0" encoding="utf-8"?>
<!-- Botao transparente (o "Voltar" do seletor de missoes e o "Nao" do
     dialogo do quiz). Mantem o estilo transparente pedido pra esse tipo de
     botao, com contorno e texto no verde padrao (Kaio, 30/09).
     Ajuste de 12/10: ganhou um preenchimento leve quando esta pressionado,
     senao o toque nao dava nenhuma resposta visual. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cascavel_button_pressed_soft" />
            <corners android:radius="@dimen/radius_button" />
            <stroke
                android:width="1dp"
                android:color="@color/cascavel_jade" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_button" />
            <stroke
                android:width="1dp"
                android:color="@color/cascavel_jade" />
        </shape>
    </item>

</selector>
