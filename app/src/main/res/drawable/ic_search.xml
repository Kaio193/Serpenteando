<?xml version="1.0" encoding="utf-8"?>
<!-- Lupa simples do botao "Mitos" (item 15 do Kaio, 11/10/2026).
     Nao entrou dependencia nenhuma: o projeto nao tinha lupa, entao o icone
     segue o MESMO padrao dos outros (vector + stroke), no estilo do ic_mitos.
     A cor final quem define e o app:tint do layout (@color/home_icon_tint). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Aro da lupa -->
    <path
        android:pathData="M11,4a7,7 0 1,0 0.01,0z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round" />
    <!-- Cabo -->
    <path
        android:pathData="M16.2,16.2L21,21"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />
</vector>
