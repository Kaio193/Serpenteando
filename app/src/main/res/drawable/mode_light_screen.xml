<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo das telas (Ajustes + Sobre).
     Antes a textura entrava 100% chapada e escurecia a tela toda; agora ela
     vem em 50% pra "casar" com o fundo do tema.
     O @drawable/mode_light já troca sozinho entre a arte clara e a escura. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/mode_light"
            android:alpha="0.5"
            android:gravity="fill" />
    </item>
</layer-list>
