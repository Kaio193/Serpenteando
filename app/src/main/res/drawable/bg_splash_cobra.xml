<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo da splash: UMA cor so (item 16 do Kaio, 11/10/2026).
     Antes eram 3 tons (base + 2 ovais concentricos), que davam a impressao de
     "mudanca de cor / transicao" na abertura. Agora e uma cor chapada, usando a
     cor REAL de fundo do modo claro do app (cascavel_bg_light) — a mesma do
     android:windowBackground do tema, entao a abertura nao pisca nem muda de tom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cascavel_bg_light" />
        </shape>
    </item>
</layer-list>
