<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cascavel_bg" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/cascavel_surface" />
            <size
                android:width="240dp"
                android:height="240dp" />
        </shape>
    </item>
    <item android:gravity="center" android:top="48dp">
        <shape android:shape="oval">
            <solid android:color="@color/cascavel_surface_container" />
            <size
                android:width="120dp"
                android:height="120dp" />
        </shape>
    </item>
</layer-list>
