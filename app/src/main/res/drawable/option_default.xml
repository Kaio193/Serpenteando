<?xml version="1.0" encoding="utf-8"?>
<!-- Alternativa do quiz (estado normal) + resposta ao toque. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cascavel_button_pressed_soft" />
            <stroke android:width="1dp" android:color="@color/cascavel_jade_bright" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cascavel_card_bg" />
            <stroke android:width="1dp" android:color="@color/cascavel_card_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>

</selector>
