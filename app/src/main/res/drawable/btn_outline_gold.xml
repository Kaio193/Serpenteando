<?xml version="1.0" encoding="utf-8"?>
<!-- Botao transparente pilula (so o "Verificar progresso" da missao).
     Segue sendo transparente, com o contorno no verde padrao dos botoes
     (Kaio, 30/09) — antes era dourado. O nome do arquivo ficou, pra nao
     mexer na estrutura do projeto.
     Ajuste de 12/10: ganhou preenchimento leve e contorno mais forte quando
     pressionado, senao o toque nao dava resposta visual. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/cascavel_outline" />
            <corners android:radius="999dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cascavel_button_pressed_soft" />
            <stroke android:width="2dp" android:color="@color/cascavel_jade_bright" />
            <corners android:radius="999dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/cascavel_jade" />
            <corners android:radius="999dp" />
        </shape>
    </item>

</selector>
