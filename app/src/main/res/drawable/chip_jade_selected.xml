<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Estado SELECIONADO do chip jade. O preenchimento e o MESMO verde da
         classificacao "Inofensiva" (cascavel_jade_bright = #66BB6A) — a selecao
         e marcada so pelo anel mais forte (cascavel_jade_dim), sem trocar o tom
         de fundo dos botoes (itens 2, 5, 6 e 8 do Kaio, 11/10/2026). -->
    <solid android:color="@color/cascavel_jade_bright" />
    <stroke
        android:width="1.5dp"
        android:color="@color/cascavel_jade_dim" />
    <corners android:radius="@dimen/radius_circular" />
</shape>
