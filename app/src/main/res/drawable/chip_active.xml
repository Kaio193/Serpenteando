<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Selecionado = base neutra escura + anel jade pra marcar qual esta
         selecionado. Usa o token cascavel_chip_idle (e nao cascavel_button)
         pra nao virar verde quando os botoes mudaram pra #4CAF50 em 30/09. -->
    <solid android:color="@color/cascavel_chip_idle" />
    <stroke
        android:width="1.5dp"
        android:color="@color/cascavel_jade_bright" />
    <corners android:radius="@dimen/radius_circular" />
</shape>
