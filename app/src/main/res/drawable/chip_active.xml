<?xml version="1.0" encoding="utf-8"?>
<!-- Filtro SELECIONADO (Kaio, 11/10 — itens 5 e 6): mesmo verde do filtro
     nao selecionado, com o texto branco; o que marca qual esta ativo e o
     anel. O preenchimento nao muda de tom, como o Kaio pediu.
     Ajuste de 12/10: a base virou o verde #499959 (cor principal dos botoes)
     e o anel ficou mais grosso (2.5dp) pra a diferenca entre selecionado e
     nao selecionado ficar perceptivel — antes era 1.5dp contra 1dp, quase
     invisivel. Ganhou tambem o estado pressionado. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cascavel_button_pressed" />
            <stroke
                android:width="2.5dp"
                android:color="@color/cascavel_jade_dim" />
            <corners android:radius="@dimen/radius_circular" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cascavel_button" />
            <stroke
                android:width="2.5dp"
                android:color="@color/cascavel_jade_dim" />
            <corners android:radius="@dimen/radius_circular" />
        </shape>
    </item>

</selector>
