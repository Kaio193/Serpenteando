<?xml version="1.0" encoding="utf-8"?>
<!-- Filtro NAO selecionado (Kaio, 11/10 — itens 5 e 6): mesmo verde do
     selecionado, texto branco, e so o anel fino/neutro diferencia. Antes era
     a base cinza escura, que o Kaio descreveu como "apagado".
     Ajuste de 12/10: a base virou o verde #499959 (cor principal dos botoes)
     e o anel do selecionado ficou mais grosso, pra dar pra ver qual esta
     ativo. Ganhou tambem o estado pressionado. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cascavel_button_pressed" />
            <stroke android:width="1dp" android:color="@color/cascavel_outline" />
            <corners android:radius="@dimen/radius_circular" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cascavel_button" />
            <stroke android:width="1dp" android:color="@color/cascavel_outline" />
            <corners android:radius="@dimen/radius_circular" />
        </shape>
    </item>

</selector>
