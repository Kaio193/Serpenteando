<?xml version="1.0" encoding="utf-8"?>
<!-- Botao principal do dialog do Quiz.
     Kaio, 11/10 (item 8): ficou separado do dialog_btn_primary pra o verde
     da classificacao "Inofensiva" valer SO no quiz.
     Ajuste de 12/10: a cor de TODOS os botoes passou a ser o verde #499959,
     entao este botao acompanha os outros (o "Inofensiva" continua nos
     filtros e no icone do dialog) — e ganhou os estados de pressionado e
     desabilitado, que antes nao existiam. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/cascavel_button_disabled" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cascavel_button_pressed" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cascavel_button" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>

</selector>
