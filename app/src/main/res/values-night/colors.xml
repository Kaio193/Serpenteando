    <!-- Botoes: mesma cor do tema claro. Desde 12/10/2026 o valor e o verde
         #499959, e e ele que define a cor de TODOS os botoes nos dois temas.
         Os estados de toque (pressed/disabled) sao os mesmos do tema claro,
         senao o botao mudaria de tom ao trocar de tema. -->
    <color name="cascavel_button">#499959</color>
    <color name="cascavel_on_button">#FFFFFF</color>
    <color name="cascavel_button_pressed">#3C7D4A</color>
    <color name="cascavel_button_disabled">#66499959</color>
    <color name="cascavel_button_pressed_soft">#1F499959</color>

    <!-- Chips/botoes de escolha: mesmo verde padrao dos botoes (Kaio, 07/10).
         Antes era a base cinza #3A423E. -->
    <color name="cascavel_chip_idle">@color/cascavel_button</color>

    <!-- Cards do Conteudo Educativo e de Mitos e Verdades (Kaio, 07/10):
         o verde escuro #152920 vale SÓ no modo escuro. No modo claro o card
         usa o tom dos grupos de Configurações (ver values/colors.xml). -->
    <color name="cascavel_card_dark">#152920</color>
    <color name="cascavel_on_card_dark">#F2F5F2</color>
    <color name="cascavel_on_card_dark_variant">#A9BFB2</color>
