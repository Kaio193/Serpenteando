<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Splash estatica do MODO ESCURO — par da do claro (Kaio, 12/10).
         Antes era um layer-list com dois circulos (240dp e 120dp) atras do
         favicon, que apareciam como "umas coisas atras" do logo e do nome. O
         Kaio pediu deixar igual ao claro: so o fundo liso, sem nada atrás.
         A cor e a de fundo real do modo escuro (cascavel_bg = #0B1210), a mesma
         que o windowSplashScreenBackground do tema Dark ja usa — entao a splash
         do sistema e a nossa ficam identicas, sem transicao de tonalidade. -->
    <solid android:color="@color/cascavel_bg" />
</shape>
