    <!-- ========== TOUR 3D - ANATOMIA ========== -->
    <string name="tour_0_name">Escamas y Piel</string>
    <string name="tour_0_func">Protección, camuflaje y percepción sensorial</string>
    <string name="tour_0_how">Placas de queratina que cubren todo el cuerpo.</string>
    <string name="tour_0_curio">El cascabel está hecho de queratina.</string>
    <string name="tour_1_name">Capa Muscular</string>
    <string name="tour_1_func">Locomoción, constricción y ataque</string>
    <string name="tour_1_how">~300 pares de músculos a lo largo de la columna.</string>
    <string name="tour_1_curio">Velocidad de ataque hasta 2,5 m/s.</string>
    <string name="tour_2_name">Tejido Interno y Conectivo</string>
    <string name="tour_2_func">Soporte estructural y aislamiento</string>
    <string name="tour_2_how">Tejido conjuntivo que protege los órganos.</string>
    <string name="tour_2_curio">Puede sobrevivir 2 años sin comer.</string>
    <string name="tour_3_name">Esqueleto Completo</string>
    <string name="tour_3_func">Estructura axial y anclaje muscular</string>
    <string name="tour_3_how">150-300 vértebras con costillas articuladas.</string>
    <string name="tour_3_curio">La cascabel no tiene extremidades.</string>
    <string name="tour_4_name">Cráneo</string>
    <string name="tour_4_func">Protección cerebral y captura de presas</string>
    <string name="tour_4_how">Huesos móviles conectados por ligamentos.</string>
    <string name="tour_4_curio">Forma triangular característica.</string>
    <string name="tour_5_name">Colmillos</string>
    <string name="tour_5_func">Inyección de veneno por hipodermia</string>
    <string name="tour_5_how">Dientes modificados huecos y retráctiles.</string>
    <string name="tour_5_curio">Miden 1-3 cm, se reemplazan continuamente.</string>
    <string name="tour_6_name">Glándulas de Veneno</string>
    <string name="tour_6_func">Producción y almacenamiento de toxinas</string>
    <string name="tour_6_how">Estructuras alargadas detrás de los ojos.</string>
    <string name="tour_6_curio">Una dosis puede matar hasta 20 ratas.</string>
    <string name="tour_7_name">Dientes</string>
    <string name="tour_7_func">Agarre y retención de presas</string>
    <string name="tour_7_how">Filas de dientes curvados en el pterigoideo.</string>
    <string name="tour_7_curio">Puede tener hasta 200 dientes.</string>
    <string name="tour_8_name">Lengua Bifurcada</string>
    <string name="tour_8_func">Recolección de partículas químicas</string>
    <string name="tour_8_how">Língua larga fina y bifurcada.</string>
    <string name="tour_8_curio">Permite detección estereoscópica de olores.</string>
    <string name="tour_9_name">Órgano de Jacobson</string>
    <string name="tour_9_func">Análisis químico de feromonas</string>
    <string name="tour_9_how">Cámaras sensoriales en el paladar.</string>
    <string name="tour_9_curio">Puede detectar presas a 200 metros.</string>
    <string name="tour_10_name">Cerebro</string>
    <string name="tour_10_func">Procesamiento sensorial</string>
    <string name="tour_10_how">Pequeño pero especializado.</string>
    <string name="tour_10_curio">Activo con solo 15°C.</string>
    <string name="tour_11_name">Sistema Nervioso</string>
    <string name="tour_11_func">Control motor y reflejos</string>
    <string name="tour_11_how">Cerebro, médula espinal y nervios.</string>
    <string name="tour_11_curio">Decapitada puede atacar 60 minutos.</string>
    <string name="tour_12_name">Sistema Circulatorio</string>
    <string name="tour_12_func">Transporte de oxígeno y nutrientes</string>
    <string name="tour_12_how">Corazón tricavitario.</string>
    <string name="tour_12_curio">Puede redirigir flujo sanguíneo.</string>
    <string name="tour_13_name">Corazón</string>
    <string name="tour_13_func">Bombeo sanguíneo</string>
    <string name="tour_13_how">2 aurículas, 1 ventrículo funcional.</string>
    <string name="tour_13_curio">Puede desplazarse al tragar presas.</string>
    <string name="tour_14_name">Sistema Respiratorio</string>
    <string name="tour_14_func">Intercambio gaseoso</string>
    <string name="tour_14_how">Pulmón único funcional.</string>
    <string name="tour_14_curio">Puede contener respiración 30 minutos.</string>
    <string name="tour_15_name">Sistema Digestivo</string>
    <string name="tour_15_func">Digestión de presas enteras</string>
    <string name="tour_15_how">Ácido clorhídrico y enzimas potentes.</string>
    <string name="tour_15_curio">pH estomacal alcanza 1,0.</string>
    <string name="tour_16_name">Hígado</string>
    <string name="tour_16_func">Metabolismo y almacenamiento</string>
    <string name="tour_16_how">Alargado y multillobulado.</string>
    <string name="tour_16_curio">Almacena hasta 30% del peso corporal.</string>
    <string name="tour_17_name">Riñones</string>
    <string name="tour_17_func">Excreción y osmorregulación</string>
    <string name="tour_17_how">Alargados y lobulados.</string>
    <string name="tour_17_curio">Pierde menos de 1% de agua por día.</string>
    <string name="tour_18_name">Intestinos</string>
    <string name="tour_18_func">Absorción de nutrientes</string>
    <string name="tour_18_how">Intestino delgado corto para carnívoro.</string>
    <string name="tour_18_curio">Puede pasar semanas sin defecar.</string>
    <string name="tour_19_name">Sistema Reproductor</string>
    <string name="tour_19_func">Ovoviviparidad</string>
    <string name="tour_19_how">Huevos se desarrollan dentro de la hembra.</string>
    <string name="tour_19_curio">Cachorros nacen con veneno activo.</string>
    <string name="tour_20_name">Columna Vertebral</string>
    <string name="tour_20_func">Eje axial flexible</string>
    <string name="tour_20_how">150-300 vértebras procélicas.</string>
    <string name="tour_20_curio">Puede curvar 180 grados en 0,5s.</string>
    <string name="tour_21_name">Costillas</string>
    <string name="tour_21_func">Protección visceral</string>
    <string name="tour_21_how">Par de costillas articuladas por vértebra.</string>
    <string name="tour_21_curio">Expanden diámetro corporal 3 veces.</string>
    <string name="tour_22_name">Cola y Cascabel</string>
    <string name="tour_22_func">Señalización acústica de defensa</string>
    <string name="tour_22_how">Segmentos de queratina hueca.</string>
    <string name="tour_22_curio">Vibra 50-60 veces por segundo.</string>

