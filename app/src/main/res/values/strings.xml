    <string name="onboard_desc_1">Explore informações detalhadas sobre cobras brasileiras, aprenda a identificar espécies e entenda seus habitats.</string>
    <string name="onboard_desc_2">Desafie-se com quizzes interativos sobre os mais diversos temas do mundo das serpentes.</string>
    <string name="onboard_desc_3">Ganhe pontos e desbloqueie conquistas completando missões e atividades educativas.</string>
    <!-- ========== TOUR 3D - ANATOMIA ========== -->
    <string name="tour_0_name">Escamas e Pele</string>
    <string name="tour_0_func">Proteção, camuflagem e percepção sensorial</string>
    <string name="tour_0_how">As escamas da Cascavel são placas de queratina que cobrem todo o corpo.</string>
    <string name="tour_0_curio">O chocalho é feito de queratina igual as escamas.</string>
    <string name="tour_1_name">Camada Muscular</string>
    <string name="tour_1_func">Locomoção, constrição e ataque</string>
    <string name="tour_1_how">Possui ~300 pares de músculos ao longo da coluna vertebral.</string>
    <string name="tour_1_curio">A velocidade de ataque pode chegar a 2,5 m/s.</string>
    <string name="tour_2_name">Tecido Interno e Conectivo</string>
    <string name="tour_2_func">Suporte estrutural e isolamento</string>
    <string name="tour_2_how">O tecido conjuntivo envolve e protege os órgãos internos.</string>
    <string name="tour_2_curio">Pode sobreviver até 2 anos sem se alimentar.</string>
    <string name="tour_3_name">Esqueleto Completo</string>
    <string name="tour_3_func">Estrutura axial e ancoragem muscular</string>
    <string name="tour_3_how">Possui 150-300 vértebras com costelas articuladas.</string>
    <string name="tour_3_curio">A Cascavel não tem membros.</string>
    <string name="tour_4_name">Crânio</string>
    <string name="tour_4_func">Proteção cerebral e captura de presas</string>
    <string name="tour_4_how">Formado por ossos móveis conectados por ligamentos elásticos.</string>
    <string name="tour_4_curio">Formato triangular característico.</string>
    <string name="tour_5_name">Presas</string>
    <string name="tour_5_func">Inoculação de veneno por hipoderme</string>
    <string name="tour_5_how">Dentes modificados, ocos e retráteis na maxila.</string>
    <string name="tour_5_curio">Medem 1 a 3 cm e são substituídas continuamente.</string>
    <string name="tour_6_name">Glândulas de Veneno</string>
    <string name="tour_6_func">Produção e armazenamento de toxinas</string>
    <string name="tour_6_how">Estruturas alongadas atrás dos olhos.</string>
    <string name="tour_6_curio">Uma dose pode matar até 20 ratos adultos.</string>
    <string name="tour_7_name">Dentes</string>
    <string name="tour_7_func">Preensão e retenção de presas</string>
    <string name="tour_7_how">Fileiras de dentes recurvados no pterigoide.</string>
    <string name="tour_7_curio">Pode ter até 200 dentes.</string>
    <string name="tour_8_name">Língua Bifurcada</string>
    <string name="tour_8_func">Coleta de partículas químicas</string>
    <string name="tour_8_how">Língua longa, fina e bifurcada.</string>
    <string name="tour_8_curio">Permite detecção estereoscópica de odores.</string>
    <string name="tour_9_name">Órgão de Jacobson</string>
    <string name="tour_9_func">Análise química de feromônios</string>
    <string name="tour_9_how">Câmaras sensoriais no céu da boca.</string>
    <string name="tour_9_curio">Pode detectar presas a até 200 metros.</string>
    <string name="tour_10_name">Cérebro</string>
    <string name="tour_10_func">Processamento sensorial</string>
    <string name="tour_10_how">Pequeno mas especializado.</string>
    <string name="tour_10_curio">Funciona com apenas 15 graus C.</string>
    <string name="tour_11_name">Sistema Nervoso</string>
    <string name="tour_11_func">Controle motor e reflexos</string>
    <string name="tour_11_how">Cérebro, medula espinhal e nervos periféricos.</string>
    <string name="tour_11_curio">Decapitada pode atacar por até 60 minutos.</string>
    <string name="tour_12_name">Sistema Circulatório</string>
    <string name="tour_12_func">Transporte de oxigênio e nutrientes</string>
    <string name="tour_12_how">Coração tricavitário.</string>
    <string name="tour_12_curio">Pode redirecionar fluxo ao engolir presas.</string>
    <string name="tour_13_name">Coração</string>
    <string name="tour_13_func">Bombeamento sanguíneo</string>
    <string name="tour_13_how">2 átrios, 1 ventrículo funcional.</string>
    <string name="tour_13_curio">Pode deslocar-se ao engolir presas grandes.</string>
    <string name="tour_14_name">Sistema Respiratório</string>
    <string name="tour_14_func">Troca gasosa</string>
    <string name="tour_14_how">Pulmão único funcional.</string>
    <string name="tour_14_curio">Pode prender respiração por 30 minutos.</string>
    <string name="tour_15_name">Sistema Digestório</string>
    <string name="tour_15_func">Digestão de presas inteiras</string>
    <string name="tour_15_how">Ácido clorídrico e enzimas potentes.</string>
    <string name="tour_15_curio">pH estomacal atinge 1,0.</string>
    <string name="tour_16_name">Fígado</string>
    <string name="tour_16_func">Metabolismo e armazenamento</string>
    <string name="tour_16_how">Alongado e multilobado.</string>
    <string name="tour_16_curio">Armazena até 30% do peso corporal.</string>
    <string name="tour_17_name">Rins</string>
    <string name="tour_17_func">Excreção e osmorregulação</string>
    <string name="tour_17_how">Alongados e lobulados.</string>
    <string name="tour_17_curio">Perde menos de 1% de água por dia.</string>
    <string name="tour_18_name">Intestinos</string>
    <string name="tour_18_func">Absorção de nutrientes</string>
    <string name="tour_18_how">Intestino delgado curto para carnívoro.</string>
    <string name="tour_18_curio">Pode passar semanas sem evacuar.</string>
    <string name="tour_19_name">Sistema Reprodutor</string>
    <string name="tour_19_func">Ovoviviparidade</string>
    <string name="tour_19_how">Ovos se desenvolvem dentro da fêmea.</string>
    <string name="tour_19_curio">Filhotes nascem com veneno ativo.</string>
    <string name="tour_20_name">Coluna Vertebral</string>
    <string name="tour_20_func">Eixo axial flexível</string>
    <string name="tour_20_how">150-300 vértebras procélicas.</string>
    <string name="tour_20_curio">Pode curvar 180 graus em 0,5s.</string>
    <string name="tour_21_name">Costelas</string>
    <string name="tour_21_func">Proteção visceral</string>
    <string name="tour_21_how">Par de costelas articuladas por vértebra.</string>
    <string name="tour_21_curio">Expandem diâmetro corporal em 3 vezes.</string>
    <string name="tour_22_name">Cauda e Chocalho</string>
    <string name="tour_22_func">Sinalização acústica</string>
    <string name="tour_22_how">Segmentos de queratina oca.</string>
    <string name="tour_22_curio">Vibra 50-60 vezes por segundo.</string>

