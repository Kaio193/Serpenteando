<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Serpenteando" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Revert to the default Material3 Android Studio theme baseline -->
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Serpenteando" parent="Theme.Serpenteando.Light" />

    <style name="Theme.Serpenteando.Dark" parent="Base.Theme.Serpenteando" tools:targetApi="31">
        <!-- Cor principal do tema = o verde do app (@color/cascavel_jade, #4CAF50).
             Sem isto o Material3 usa o ROXO padrão dele e os switches de "Modo
             escuro" e "Notificações" apareciam roxos (item 20). Não é cor nova:
             é a mesma cor que os botões já usam. -->
        <item name="colorPrimary">@color/cascavel_jade</item>
        <item name="colorOnPrimary">@color/cascavel_on_button</item>
        <item name="colorPrimaryContainer">@color/cascavel_jade_dim</item>
        <item name="colorOnPrimaryContainer">@color/cascavel_on_button</item>
        <item name="colorSecondary">@color/cascavel_jade_bright</item>
        <item name="colorOnSecondary">@color/cascavel_on_button</item>
        <item name="colorSurface">@color/cascavel_surface</item>
        <item name="colorOnSurface">@color/cascavel_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/cascavel_on_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/cascavel_surface</item>
        <item name="colorSurfaceContainer">@color/cascavel_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/cascavel_surface_container_high</item>
        <item name="colorOutline">@color/cascavel_outline</item>
        <item name="colorOutlineVariant">@color/cascavel_outline_variant</item>
        <item name="android:windowBackground">@color/cascavel_bg</item>
        <item name="android:windowSplashScreenBackground">@color/cascavel_bg</item>
        <!-- Vazio: o logo + nome ficam na SplashActivity (uma tela só) -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/window_light_status_bar</item>
        <item name="android:textColorPrimary">@color/cascavel_on_bg</item>
        <item name="android:textColorSecondary">@color/cascavel_on_surface_variant</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="Theme.Serpenteando.Light" parent="Base.Theme.Serpenteando" tools:targetApi="31">
        <!-- Mesma cor principal do tema escuro (ver comentário acima) -->
        <item name="colorPrimary">@color/cascavel_jade</item>
        <item name="colorOnPrimary">@color/cascavel_on_button</item>
        <item name="colorPrimaryContainer">@color/cascavel_jade_dim</item>
        <item name="colorOnPrimaryContainer">@color/cascavel_on_button</item>
        <item name="colorSecondary">@color/cascavel_jade_bright</item>
        <item name="colorOnSecondary">@color/cascavel_on_button</item>
        <item name="colorSurface">@color/cascavel_surface_light</item>
        <item name="colorOnSurface">@color/cascavel_on_surface_light</item>
        <item name="colorOnSurfaceVariant">@color/cascavel_on_surface_variant_light</item>
        <item name="colorSurfaceContainerLow">@color/cascavel_surface_light</item>
        <item name="colorSurfaceContainer">@color/cascavel_surface_container_light</item>
        <item name="colorSurfaceContainerHigh">@color/cascavel_surface_container_high_light</item>
        <item name="colorOutline">@color/cascavel_outline_light</item>
        <item name="colorOutlineVariant">@color/cascavel_outline_variant_light</item>
        <item name="android:windowBackground">@color/cascavel_bg_light</item>
        <item name="android:windowSplashScreenBackground">@color/cascavel_bg_light</item>
        <!-- Vazio: o logo + nome ficam na SplashActivity (uma tela só) -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/cascavel_on_bg_light</item>
        <item name="android:textColorSecondary">@color/cascavel_on_surface_variant_light</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
