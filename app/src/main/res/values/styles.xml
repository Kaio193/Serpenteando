<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========== TYPOGRAPHY ========== -->
    <style name="SerpenteandoLargeTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/label_primary</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        
        <item name="android:letterSpacing">-0.012</item>
    </style>

    <style name="SerpenteandoTitle1">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/label_primary</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        
        <item name="android:letterSpacing">-0.009</item>
    </style>

    <style name="SerpenteandoTitle2">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/label_primary</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        
        <item name="android:letterSpacing">-0.008</item>
    </style>

    <style name="SerpenteandoTitle3">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/label_primary</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        
        <item name="android:letterSpacing">-0.006</item>
    </style>

    <style name="SerpenteandoHeadline">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/label_primary</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="SerpenteandoBody">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/label_primary</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="SerpenteandoSubhead">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/label_secondary</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="SerpenteandoFootnote">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/label_secondary</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="SerpenteandoCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/label_tertiary</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ========== BUTTONS ========== -->
    <!-- ========== CARDS ========== -->
    <style name="SerpenteandoCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/cascavel_surface_container_high</item>
        <item name="strokeColor">@color/cascavel_outline</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="contentPadding">@dimen/space_16</item>
    </style>

    <!-- ========== BOTTOM NAV ========== -->
    <!-- ========== TOOLBAR ========== -->

    <!-- ========== FORMAS (ShapeableImageView) ========== -->
    <!-- Avatar de verdade: recorta a foto num círculo. Antes a foto quadrada
         ficava por cima do fundo oval (circle_avatar_bg) e não arredondava nada. -->
    <style name="ShapeAppearanceOverlay.Serpenteando.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Marca do app (favicon) com cantos arredondados -->
    <style name="ShapeAppearanceOverlay.Serpenteando.Favicon" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28%</item>
    </style>
</resources>

